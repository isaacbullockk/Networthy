# Required environment variables (set these in Railway → Variables)

# MySQL-compatible database (Railway MySQL plugin or external, e.g. TiDB Cloud)
DATABASE_URL=mysql://user:password@host:port/database

# App credentials (any non-empty values work for the demo build;
# keep the same values as your local .env if you have them)
APP_ID=networthy
APP_SECRET=change-me

# Injected automatically by Railway — no need to set:
# PORT=3000
